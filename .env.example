# CairnMark configuration (12-factor env vars). Copy to .env for local use.
# All variables have safe defaults; none are required to boot in Phase 0.

# --- HTTP server ---
CAIRNMARK_HTTP_ADDR=:8080            # listen address (default :8080)
CAIRNMARK_SHUTDOWN_TIMEOUT=10s       # graceful shutdown grace period (default 10s)
CAIRNMARK_PRESIGN_TTL=15m            # lifetime of presigned download URLs (default 15m)
CAIRNMARK_MAX_UPLOAD_BYTES=0         # max upload body size in bytes; larger
                                     # uploads are rejected with 413
                                     # (default 0 = uncapped)

# --- Garbage collection (reconciliation sweep) ---
# NOTE: the sweep also expires idempotency keys, so disabling GC (<=0) lets the
# idempotency_keys table grow unbounded, in addition to leaving orphans and
# soft-deleted objects unreclaimed. Keep GC enabled in production.
CAIRNMARK_GC_INTERVAL=5m             # sweep cadence; <=0 disables GC (default 5m)
CAIRNMARK_GC_GRACE_PERIOD=1h         # min age before an unreferenced object is
                                     # reclaimed as an orphan; must exceed the
                                     # longest plausible upload (default 1h)
CAIRNMARK_IDEMPOTENCY_TTL=24h        # how long upload idempotency keys are kept
                                     # before the sweep expires them; <=0 disables
                                     # expiry (default 24h)

# --- Archive extraction (GET /files/{id}/archive, POST /files/{id}/extract) ---
# Every cap is 0 = disabled. Per-entry size is CAIRNMARK_MAX_UPLOAD_BYTES: an
# extracted entry is an upload.
CAIRNMARK_ARCHIVE_MAX_ENTRIES=1000       # zips with more entries are refused (413);
                                         # 0 means the built-in 10,000 ceiling (the
                                         # listing is one unpaginated response),
                                         # not unbounded
CAIRNMARK_ARCHIVE_MAX_TOTAL_BYTES=1073741824  # uncompressed bytes one extraction
                                              # may write (default 1 GiB)
#CAIRNMARK_ARCHIVE_MAX_DIRECTORY_BYTES=0 # bytes the central directory may span;
                                         # refused (413) BEFORE it is parsed, the
                                         # only bound that can precede the
                                         # allocation. 0 does not disable it: it
                                         # derives from MAX_ENTRIES at 512 bytes
                                         # per entry. Raise only for very long
                                         # paths (default 0 = derived)
CAIRNMARK_ARCHIVE_MAX_RATIO=100          # per-entry uncompressed/compressed ratio;
                                         # higher is a zip bomb and is skipped.
                                         # Deflate reaches ~1032:1, so 100 also
                                         # skips very repetitive documents (CSV of
                                         # repeated values, logs, XML exports)
#CAIRNMARK_ARCHIVE_EXTENSIONS=pdf,docx,xlsx   # allowlist; unset = every extension

# --- Extraction jobs (the worker behind POST /files/{id}/extract) ---
# An extraction runs as a job: submitted with 202, run by a worker in this
# process, polled at GET /jobs/{id}. One global knob each; no per-job policy.
CAIRNMARK_JOB_CONCURRENCY=1              # jobs one replica runs at once. 1 on
                                         # purpose: extraction is IO-bound on the
                                         # store, two workers never share one
                                         # archive anyway, and each run pins a read
                                         # window plus a multipart part of memory.
                                         # Raise it with evidence; must be >= 1
CAIRNMARK_JOB_HEARTBEAT_TTL=5m           # a running job whose heartbeat is older
                                         # than this had its worker die, and goes
                                         # back to the queue to be resumed. Too
                                         # long blocks the archive that long after
                                         # a crash; too short steals a healthy run.
                                         # Must be > 0 — 0 is refused, not
                                         # "disabled" (default 5m)
CAIRNMARK_JOB_RETENTION=24h              # how long a finished job stays readable
                                         # at GET /jobs/{id} before the GC sweep
                                         # deletes it; <=0 disables the sweep. Past
                                         # it the job is 404; the extracted files
                                         # are permanent (default 24h)

# --- Postgres metadata (wired in Phase 1) ---
# Matches the docker-compose Postgres service.
CAIRNMARK_POSTGRES_DSN=postgres://cairnmark:cairnmark@localhost:5432/cairnmark?sslmode=disable

# --- S3-compatible storage (wired in Phase 1) ---
# Matches the docker-compose RustFS service (the default substrate). Nothing
# below is backend-specific. The MinIO overlay (compose.minio.yml) also serves
# S3 on localhost:9000, so these values carry over unchanged; the SeaweedFS
# overlay (compose.seaweedfs.yml) uses localhost:8333 instead.
CAIRNMARK_S3_ENDPOINT=localhost:9000   # host:port for service-side I/O, no scheme
CAIRNMARK_S3_REGION=us-east-1
CAIRNMARK_S3_ACCESS_KEY=cairnmark
CAIRNMARK_S3_SECRET_KEY=cairnmark-secret
CAIRNMARK_S3_BUCKET=cairnmark
CAIRNMARK_S3_USE_SSL=false

# Public endpoint baked into presigned download URLs. Leave unset to reuse
# CAIRNMARK_S3_ENDPOINT. Set this when the service reaches the store by an
# internal name (e.g. rustfs:9000 inside Compose) but external clients use a
# different public host. The host is part of the URL signature, so it is signed
# directly against this value — it cannot be rewritten after signing.
#CAIRNMARK_S3_PUBLIC_ENDPOINT=files.example.com
#CAIRNMARK_S3_PUBLIC_USE_SSL=true       # defaults to CAIRNMARK_S3_USE_SSL
